// Ejemplo 1: variables, aritmetica, strings e if
// Salida esperada:
// 14
// 26
// hola
// grande
method main {
  val a = 2
  val b = 3
  var c = a * b + 8
  println(c)
  c = c * 2 - 2
  println(c)
  val saludo = "hola"
  println(saludo)
  if c > 20 then println("grande") else println("pequeno")
}
